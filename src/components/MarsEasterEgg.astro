---
/**
 * Easter egg: Mars gets launched to Mars - or, on the "lynix" site theme, Lynix gets launched to the Moon.
 *
 * Trigger:  triple-click the profile picture, or type "mars" anywhere on the home page.
 * Escape:   Esc or Skip cancels the launch - but only until touchdown. After landing there is no way back:
 *           "Stay on Mars/Moon" (or Esc) makes the destination the site's background permanently
 *           (localStorage 'mars-landed', 'mars-landed-kind').
 * Debug:    marsEgg.launch(seconds) in the console starts the sequence part-way through;
 *           marsEgg.launch(seconds, true) freezes it at that moment.
 *
 * Timeline (seconds):
 *  before 0   streetcars drive off screen (page content is hidden meanwhile so we can watch), then the pad is placed
 *    0 - 10   10 second countdown on the pad; no turning back past T-5; the last 5 seconds are the engine ignition (shake, smoke, flame ramp up)
 *   10 - 19   liftoff - the camera follows the rocket up; the Toronto sky slowly deepens into space
 *   19 - 20.6 fade through black
 *   20.6+     powered landing, hatch opens, the pilot steps out and plants a flag; background becomes
 *             Mars or the Moon, matching the destination
 *
 * Everything is drawn on a small canvas at the same "art pixel" size as the city scene, so it matches.
 * The overlay is created when the egg is triggered and removed afterwards, so it survives page transitions.
 */
---

<script>
	// @ts-nocheck
	import { clamp, mixC, rgb, rng, drawRocket, makeMarsWorld, characterName, isLynix } from '../scene/mars-art.js';

	const CD = 10;                 // countdown length
	const NO_RETURN = 5;           // cancelling is possible until T-NO_RETURN, then it's locked in
	const IGN = 5;                 // the last IGN seconds are the engine ignition sequence
	const T_LIFT = CD + 9;         // the climb ends and we fade out
	const T_SURF = T_LIFT + 0.8;   // moment we cut to the Martian surface (mid-fade)
	const T_END_FADE = T_LIFT + 1.6;
	const CLEAR_TIMEOUT = 20000;   // ms we'll wait for the streetcars to leave before launching anyway
	const LANDED_KEY = 'mars-landed';
	const LANDED_KIND_KEY = 'mars-landed-kind'; // 'mars' or 'moon' - which destination was landed on
	const hasLanded = () => { try { return localStorage.getItem(LANDED_KEY) === '1'; } catch (e) { return false; } };

	// Countdown messages: [highest second it applies to, text]; the first entry whose limit covers n wins
	const MESSAGES = [
		[0, 'LIFTOFF!'], [1, 'Ignition'], [2, 'Engines at full thrust'], [3, 'Main engine start'], [4, 'Water deluge on the pad'],
		[5, 'Engine ignition sequence'], [7, 'Ignition sequence armed'], [10, '{name} seated and locked in'],
	];
	const messageFor = n => (MESSAGES.find(([max]) => n <= max) || [0, ''])[1].replace('{name}', characterName());

	let active = false;

	const smooth = t => t * t * (3 - 2 * t);

	/** Launch pad under the rocket, with two floodlight masts. y is the top of the pad. */
	function drawPad(g, cx, y, t) {
		g.fillStyle = '#171a2b'; g.fillRect(cx - 20, y + 1, 40, 4);
		g.fillStyle = '#3a3f55'; g.fillRect(cx - 18, y - 1, 36, 3);
		g.fillStyle = '#5a6080'; g.fillRect(cx - 18, y - 1, 36, 1);
		for (let i = 0; i < 9; i++) { g.fillStyle = i % 2 ? '#111' : '#e0b020'; g.fillRect(cx - 18 + i * 4, y + 2, 4, 1); }
		for (const s of [-1, 1]) {
			const mx = cx + s * 27;
			g.fillStyle = '#5a6080'; g.fillRect(mx, y - 40, 2, 42);
			g.fillStyle = '#8a90a8'; g.fillRect(mx - 2, y - 43, 6, 3);
			g.globalAlpha = .18 + .05 * Math.sin(t * 6); g.fillStyle = '#fff3c8'; g.beginPath(); g.moveTo(mx + 1, y - 41); g.lineTo(cx - s * 2, y - 2); g.lineTo(cx + s * 8, y - 2); g.closePath(); g.fill();
			g.globalAlpha = 1; g.fillStyle = '#fff8dc'; g.fillRect(mx - 1, y - 42, 4, 1);
		}
	}

	/* ---------- the launch ---------- */
	function launch(startAt = 0, freeze = false) {
		if (active || hasLanded()) return;
		const city = document.querySelector('#city-background');
		if (startAt > 0 || freeze || !city) return begin(startAt, freeze);
		// Ask the city to drive every streetcar off screen, then place the pad
		active = true;
		document.documentElement.classList.add('mars-clearing');   // hide the page content so the street is clearly visible
		let started = false;
		const cleanup = () => { started = true; clearTimeout(timer); removeEventListener('mars-street-clear', go); removeEventListener('keydown', abort); };
		const go = () => { if (started) return; cleanup(); active = false; begin(startAt, freeze); };
		const abort = e => { if (e.key !== 'Escape' || started) return; cleanup(); active = false; document.documentElement.classList.remove('mars-clearing'); dispatchEvent(new Event('mars-resume-street')); };
		const timer = setTimeout(go, CLEAR_TIMEOUT);
		addEventListener('mars-street-clear', go);
		addEventListener('keydown', abort);
		dispatchEvent(new Event('mars-clear-street'));
	}
	function begin(startAt, freeze) {
		const city = document.querySelector('#city-background');
		let W, H, P;
		if (city && city.width) { W = city.width; H = city.height; P = parseFloat(city.style.width) / W || 2; }
		else { P = Math.max(2, Math.floor(Math.min(innerWidth / 360, innerHeight / 190))); W = Math.ceil(innerWidth / P); H = Math.ceil(innerHeight / P); }
		active = true;
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		// On the "lynix" site theme the destination is the Moon instead of Mars - fixed for this whole run,
		// even if someone flips the theme mid-launch.
		const kind = isLynix() ? 'moon' : 'mars';
		const destName = kind === 'moon' ? 'MOON' : 'MARS', placeName = kind === 'moon' ? 'the Moon' : 'Mars';

		// overlay
		const root = document.createElement('div');
		root.id = 'mars-egg'; root.setAttribute('role', 'dialog'); root.setAttribute('aria-label', 'Launch'); root.tabIndex = -1;
		root.innerHTML = `
			<canvas></canvas>
			<div class="me-hud"><div class="me-badge"><b>TORONTO → ${destName}</b><span class="me-readout"></span></div></div>
			<div class="me-count"><div class="me-num"></div><div class="me-warn" style="visibility:hidden">No turning back</div><div class="me-msg"></div><button class="me-skip" type="button">Cancel launch</button></div>
			<div class="me-title"><h2></h2><p>You made it. The first fursona on ${kind === 'moon' ? 'the Moon' : 'the red planet'}. There's no going back.</p><button class="me-return" type="button">Stay on ${placeName}</button></div>`;
		document.body.appendChild(root);
		const prevOverflow = document.documentElement.style.overflow;
		document.documentElement.style.overflow = 'hidden';
		const canvas = root.querySelector('canvas');
		canvas.width = W; canvas.height = H; canvas.style.width = W * P + 'px'; canvas.style.height = H * P + 'px';
		const g = canvas.getContext('2d'); g.imageSmoothingEnabled = false;
		root.querySelector('.me-title h2').textContent = kind === 'moon' ? `${characterName()}, meet the Moon.` : `${characterName()}, meet Mars.`;
		const numEl = root.querySelector('.me-num'), msgEl = root.querySelector('.me-msg'), readEl = root.querySelector('.me-readout');
		const warnEl = root.querySelector('.me-warn'), countEl = root.querySelector('.me-count'), titleEl = root.querySelector('.me-title'), skipEl = root.querySelector('.me-skip');
		requestAnimationFrame(() => root.classList.add('on'));

		// The live city keeps running under the overlay during the countdown. At liftoff we grab a snapshot of it
		// (same frame, so no visible jump) and scroll that away as the rocket climbs.
		const hasCity = !!(city && city.width);
		let snap = null;
		let skyTop = [11, 14, 38];   // colour of the Toronto sky at the top of the screen, so the climb blends in from it
		if (hasCity) root.style.background = 'transparent';
		function takeSnap() {
			root.style.background = '';
			if (!hasCity) return;
			snap = document.createElement('canvas'); snap.width = W; snap.height = H;
			const sg = snap.getContext('2d'); sg.drawImage(city, 0, 0);
			try { const d = sg.getImageData(Math.round(W * .5), 1, 1, 1).data; skyTop = [d[0], d[1], d[2]]; } catch (e) { }
		}
		let snapTaken = false;

		// world set-up
		const r = rng(5);
		const stars = Array.from({ length: 150 }, () => ({ x: r() * W, y: r() * H, z: .3 + r() * .7, tw: r() * 6 }));
		const rx = Math.round(W * .42), groundBase = H - 22;
		const world = makeMarsWorld(W, H, { kind, character: kind === 'moon' ? 'lynix' : 'mars' }), gy = world.gy;
		const smoke = [];

		let raf = 0, done = false, lastN = -1, last = performance.now(), simT = startAt;
		const t0 = performance.now() - startAt * 1000;

		function spawnSmoke(x, y, spread, big) {
			smoke.push({ x, y, vx: (Math.random() - .5) * spread, vy: -Math.random() * (big ? 6 : 14), life: 0, max: 1.4 + Math.random() * 1.6, s: big ? 3 + Math.floor(Math.random() * 4) : 2 });
		}

		// Skipping before touchdown just cancels the launch. Once we've landed there is no way back:
		// leaving the overlay makes Mars the site's background for good.
		function commit() {
			try { localStorage.setItem(LANDED_KEY, '1'); localStorage.setItem(LANDED_KIND_KEY, kind); } catch (e) { /* private mode: it lasts until reload */ }
			window.dispatchEvent(new CustomEvent('mars-landed', { detail: kind }));
			close();
		}
		function close() {
			if (done) return; done = true; cancelAnimationFrame(raf);
			removeEventListener('keydown', onKey);
			root.classList.remove('on');
			dispatchEvent(new Event('mars-resume-street'));
			document.documentElement.classList.remove('mars-clearing');
			setTimeout(() => { root.remove(); document.documentElement.style.overflow = prevOverflow; active = false; }, 500);
		}
		// Cancelling is possible until T-NO_RETURN; after that it's locked until touchdown.
		const locked = () => simT >= CD - NO_RETURN && simT < T_SURF;
		function leave() { if (locked()) return; (simT >= T_SURF ? commit : close)(); }
		function onKey(e) { if (e.key === 'Escape') leave(); }
		addEventListener('keydown', onKey);
		skipEl.addEventListener('click', leave);
		root.querySelector('.me-return').addEventListener('click', commit);
		skipEl.focus({ preventScroll: true });

		/* --- drawing pieces --- */
		function drawStars(space, drift, speed) {
			for (const s of stars) {
				const a = (.35 + .65 * (.5 + .5 * Math.sin(simT * 2 + s.tw))) * space;
				g.globalAlpha = a; g.fillStyle = s.z > .85 ? '#ffe6b0' : '#ffffff';
				const y = ((s.y + drift * s.z) % H + H) % H;
				g.fillRect(s.x | 0, y | 0, 1, speed > 0 ? Math.max(1, Math.round(speed * s.z * .08)) : 1);
			}
			g.globalAlpha = 1;
		}
		function drawSmoke(camY, dt) {
			for (let i = smoke.length - 1; i >= 0; i--) {
				const p = smoke[i]; p.life += dt; p.x += p.vx * dt; p.y += p.vy * dt; p.vx *= 1 - dt * .6;
				if (p.life > p.max) { smoke.splice(i, 1); continue; }
				const a = 1 - p.life / p.max; g.globalAlpha = a * .55; g.fillStyle = a > .6 ? '#e9ecf5' : '#aab0c4';
				const s = p.s + Math.floor(p.life * 2); g.fillRect((p.x - s / 2) | 0, (p.y + camY - s / 2) | 0, s, s);
			}
			g.globalAlpha = 1;
		}
		/* --- the frame --- */
		function frame(now) {
			if (done) return;
			const dt = Math.min(.05, (now - last) / 1000); last = now;
			simT = freeze ? startAt : (now - t0) / 1000;
			const t = simT;
			g.setTransform(1, 0, 0, 1, 0, 0); g.globalAlpha = 1; g.clearRect(0, 0, W, H);
			let hud = '', showCount = false;
			const lock = locked();
			if (warnEl.style.visibility !== (lock ? 'visible' : 'hidden')) { warnEl.style.visibility = lock ? 'visible' : 'hidden'; skipEl.style.display = lock ? 'none' : ''; }

			if (t < T_SURF) {
				/* ===== on the pad, then straight up out of the Toronto sky ===== */
				const lt = Math.max(0, t - CD), alt = lt < 3 ? 14 * lt * lt : 126 + 84 * (lt - 3);   // speeds up, then cruises
				const camY = Math.max(0, alt - H * .35);
				const space = smooth(clamp(alt / (H * 2.2), 0, 1));
				const shake = reduce ? 0 : (t > CD - IGN && t < CD ? .4 + .6 * (t - (CD - IGN)) / IGN : t >= CD && t < CD + 2.2 ? 1.5 : 0);
				g.translate(shake ? Math.round((Math.random() - .5) * 2 * shake) : 0, shake ? Math.round((Math.random() - .5) * 2 * shake) : 0);
				if (t >= CD && !snapTaken) { snapTaken = true; takeSnap(); }
				if (t >= CD || !hasCity) {   // during the countdown the live city shows through instead
					g.fillStyle = rgb(mixC(skyTop, [2, 3, 10], space)); g.fillRect(-4, -4, W + 8, H + 8);
					drawStars(space * space, camY * .25, clamp(lt - 3, 0, 1) * 110 * space);
					if (snap) g.drawImage(snap, 0, camY);
					else { g.fillStyle = '#12142e'; g.fillRect(0, groundBase + camY, W, H); }
				}
				drawPad(g, rx, Math.round(groundBase + camY), simT);
				// smoke and steam on the pad
				if (t > CD - IGN && alt < 90) for (let i = 0, n = t >= CD ? 3 : Math.random() < (t - (CD - IGN)) / IGN ? 1 : 0; i < n; i++) spawnSmoke(rx + (Math.random() - .5) * 8, groundBase - alt + 2, t >= CD ? 70 : 24, true);
				if (t >= CD && alt >= 20 && alt < 400) spawnSmoke(rx + (Math.random() - .5) * 4, groundBase - alt + 4, 8, false);
				drawSmoke(camY, dt);
				const flame = t < CD - IGN ? 0 : t < CD ? (t - (CD - IGN)) / IGN * .45 : Math.min(1, .45 + lt * .8);
				const jitter = !reduce && t > CD - 3 && t < CD + .5 ? Math.round((Math.random() - .5) * 2) : 0;
				drawRocket(g, rx + jitter, Math.round(groundBase - alt + camY), { flame, legs: alt < 4 });
				if (t < CD) { showCount = true; const n = Math.ceil(CD - t); if (n !== lastN) { lastN = n; numEl.textContent = n === 0 ? '0' : String(n); msgEl.textContent = messageFor(n); numEl.classList.remove('pop'); void numEl.offsetWidth; numEl.classList.add('pop'); } }
				else if (lastN !== 0) { lastN = 0; numEl.textContent = '0'; msgEl.textContent = 'LIFTOFF!'; numEl.classList.remove('pop'); void numEl.offsetWidth; numEl.classList.add('pop'); }
				if (t >= CD && t < CD + 2.4) showCount = true;
				hud = t < CD ? `T-${String(Math.ceil(CD - t)).padStart(2, '0')}` : `T+${lt.toFixed(1)}s · ALT ${Math.round(alt * 40).toLocaleString('en-CA')} m`;
			} else {
				/* ===== Mars or the Moon ===== */
				const ms = t - T_SURF;
				world.draw(g, ms, dt);
				const alt = world.alt(ms);
				if (ms < world.landT + .8 && alt < 70 && Math.random() < .9) for (let i = 0; i < 2; i++) spawnSmoke(rx + (Math.random() - .5) * 10, gy + 2, 90 + (1 - alt / 70) * 30, true);
				drawSmoke(0, dt);
				world.actors(g, ms, simT);
				if (ms > 5) titleEl.classList.add('show');
				skipEl.style.display = 'none';                                  // no way back once we've touched down
				hud = kind === 'moon' ? 'MOON · Sea of Tranquility on the horizon' : 'MARS · Olympus Mons on the horizon';
			}

			if (countEl.dataset.on !== String(showCount)) { countEl.dataset.on = String(showCount); countEl.style.opacity = showCount ? '1' : '0'; }
			if (readEl.textContent !== hud) readEl.textContent = hud;
			// fade through black between the climb and the surface
			if (t > T_LIFT && t < T_END_FADE && !reduce) {
				const e = (t - T_LIFT) / (T_END_FADE - T_LIFT), a = 1 - Math.abs(e - .5) * 2;
				g.setTransform(1, 0, 0, 1, 0, 0); g.globalAlpha = clamp(a * 1.3, 0, 1); g.fillStyle = '#02030a'; g.fillRect(0, 0, W, H); g.globalAlpha = 1;
			}
			raf = requestAnimationFrame(frame);
		}
		raf = requestAnimationFrame(frame);
	}

	/* ---------- triggers ---------- */
	let typed = '';
	function onClick(e) {
		const el = e.target;
		if (el && el.closest && el.closest('.profile-avatar') && e.detail >= 3) launch();
	}
	function onType(e) {
		const t = e.target;
		if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
		if (e.key.length !== 1) return;
		typed = (typed + e.key.toLowerCase()).slice(-4);
		if (typed === 'mars' && document.querySelector('.profile-avatar')) { typed = ''; launch(); }
	}
	if (!window.__marsEggBound) {
		window.__marsEggBound = true;
		document.addEventListener('click', onClick);
		addEventListener('keydown', onType);
	}
	window.marsEgg = {
		launch,
		/** Brings Toronto back (mostly for testing): forgets the landing and reloads. */
		reset() { try { localStorage.removeItem(LANDED_KEY); localStorage.removeItem(LANDED_KIND_KEY); } catch (e) { } location.reload(); },
	};
</script>

<style is:global>
	/* While the streetcars drive away, hide the page content (nav and hero text) so we can watch them go */
	html.mars-clearing header, html.mars-clearing main > .z-10 { opacity: 0; pointer-events: none; transition: opacity 0.6s ease; }
	#mars-egg {
		position: fixed; inset: 0; z-index: 9999; background: #000; color: #fff; overflow: hidden;
		opacity: 0; transition: opacity 0.5s ease;
	}
	#mars-egg.on { opacity: 1; }
	#mars-egg canvas { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); image-rendering: pixelated; }

	#mars-egg .me-hud { position: absolute; top: 18px; left: 0; right: 0; display: flex; justify-content: center; pointer-events: none; }
	#mars-egg .me-badge {
		display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; background: rgba(0, 0, 0, 0.8);
		border: 1px solid rgba(255, 176, 32, 0.4); box-shadow: 3px 3px 0 rgba(255, 176, 32, 0.25);
		color: #ffb020; font-size: 11px; letter-spacing: 0.25em; text-transform: uppercase; text-shadow: 0 0 6px rgba(255, 176, 32, 0.6);
	}
	#mars-egg .me-readout { opacity: 0.85; }
	#mars-egg .me-readout:empty { display: none; }

	#mars-egg .me-count { position: absolute; top: 16%; left: 0; right: 0; text-align: center; pointer-events: none; opacity: 0; transition: opacity 0.4s ease; }
	#mars-egg .me-num {
		font-size: clamp(4.5rem, 16vw, 10rem); font-weight: 800; line-height: 1; letter-spacing: 0.04em;
		color: #fff; text-shadow: 0 0 6px var(--accent, #ff6b1a), 0 0 22px var(--accent, #ff6b1a), 0 2px 4px rgba(0, 0, 0, 0.9);
	}
	#mars-egg .me-num.pop { animation: mePop 0.4s ease-out; }
	#mars-egg .me-warn {
		margin-top: 10px; font-size: clamp(0.9rem, 2.8vw, 1.4rem); font-weight: 800; letter-spacing: 0.3em; text-transform: uppercase;
		color: #ff4a4a; text-shadow: 0 0 8px #ff2a2a, 0 0 22px rgba(255, 42, 42, 0.6), 0 2px 4px rgba(0, 0, 0, 0.9);
		animation: meWarn 1.1s steps(1) infinite;
	}
	@keyframes meWarn { 50% { opacity: 0.35; } }
	#mars-egg .me-msg { margin-top: 6px; font-size: clamp(0.8rem, 2.2vw, 1.1rem); letter-spacing: 0.3em; text-transform: uppercase; color: #ffb020; text-shadow: 0 0 8px rgba(0, 0, 0, 0.95); }
	@keyframes mePop { 0% { transform: scale(1.35); opacity: 0.4; } 100% { transform: scale(1); opacity: 1; } }

	#mars-egg .me-title {
		position: absolute; left: 0; right: 0; top: 13%; text-align: center; padding: 0 20px;
		opacity: 0; transform: translateY(10px); transition: opacity 0.8s ease, transform 0.8s ease; pointer-events: none;
	}
	#mars-egg .me-title.show { opacity: 1; transform: none; pointer-events: auto; }
	#mars-egg .me-title h2 {
		font-size: clamp(2rem, 6vw, 3.6rem); font-weight: 800; color: #fff; margin: 0;
		text-shadow: 0 0 8px var(--accent, #ff6b1a), 0 0 24px rgba(255, 107, 26, 0.6), 0 2px 4px rgba(0, 0, 0, 0.9);
	}
	#mars-egg .me-title p { margin: 8px 0 16px; color: #ffe2c8; text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95); }
	#mars-egg button {
		font: inherit; font-weight: 700; cursor: pointer; color: #000; background: var(--accent, #ff6b1a);
		border: 2px solid var(--accent-shadow, #7a3200); box-shadow: 4px 4px 0 var(--accent-shadow, #7a3200); padding: 10px 20px;
		transition: transform 0.1s, box-shadow 0.1s;
	}
	#mars-egg button:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--accent-shadow, #7a3200); }
	#mars-egg .me-skip { margin-top: 18px; pointer-events: auto; }
	@media (prefers-reduced-motion: reduce) { #mars-egg .me-num.pop { animation: none; } }
</style>
