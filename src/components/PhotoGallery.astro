---
/**
 * Masonry photo grid with a full-screen popup viewer.
 * Popup: click a photo; ← / → or swipe to browse; Esc, ✕ or clicking outside to close.
 * Photos can be imported images (optimized at build time) or plain /public paths like "/imgs/foo.jpg".
 * Several galleries can live on one page.
 */
import { Image, getImage } from "astro:assets";
import { ChevronLeft, ChevronRight, X, Expand } from "@lucide/astro";

interface Props {
    photos: { src: ImageMetadata | string; caption?: string }[];
}

const photos = await Promise.all(
    Astro.props.photos.map(async (photo) => ({
        ...photo,
        full: typeof photo.src === "string" ? photo.src : (await getImage({ src: photo.src, width: 2000, format: "webp" })).src,
    })),
);
---

<div class="gallery-root">
<div class="photo-gallery columns-2 lg:columns-3 gap-4">
    {photos.map((photo, i) => (
        <button
            type="button"
            class="gallery-item group relative block w-full mb-4 break-inside-avoid overflow-hidden border-2 border-[#333] bg-[#0a0a0a] cursor-zoom-in"
            style={`--delay: ${(i % 6) * 70}ms`}
            data-index={i}
            data-full={photo.full}
            data-caption={photo.caption ?? ""}
            aria-label={photo.caption ? `Open photo: ${photo.caption}` : `Open photo ${i + 1}`}
        >
            {typeof photo.src === "string" ? (
                <img src={photo.src} alt={photo.caption ?? ""} loading="lazy" class="gallery-img block w-full h-auto" />
            ) : (
                <Image
                    src={photo.src}
                    alt={photo.caption ?? ""}
                    width={800}
                    format="webp"
                    class="gallery-img block w-full h-auto"
                />
            )}
            <span class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-300" />
            <span class="absolute top-3 right-3 p-1.5 border border-white/30 bg-black/50 text-white opacity-0 scale-75 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300">
                <Expand size={14} />
            </span>
            {photo.caption && (
                <span class="absolute inset-x-0 bottom-0 p-4 text-left text-[12px] font-bold tracking-wide text-white translate-y-full group-hover:translate-y-0 group-focus-visible:translate-y-0 transition-transform duration-300">
                    {photo.caption}
                </span>
            )}
        </button>
    ))}
</div>

<dialog class="lightbox" aria-label="Photo viewer">
    <div class="lightbox-stage">
        <figure class="lightbox-figure">
            <img class="lightbox-img" src="" alt="" />
            <figcaption class="lightbox-caption"></figcaption>
        </figure>
    </div>

    <div class="lightbox-counter"></div>
    <button type="button" class="lightbox-btn lightbox-close" aria-label="Close"><X size={20} /></button>
    <button type="button" class="lightbox-btn lightbox-prev" aria-label="Previous photo"><ChevronLeft size={24} /></button>
    <button type="button" class="lightbox-btn lightbox-next" aria-label="Next photo"><ChevronRight size={24} /></button>
</dialog>
</div>

<style>
    /* ---- grid ---- */
    .gallery-item {
        opacity: 0;
        transform: translateY(24px);
        transition:
            opacity 0.6s ease var(--delay),
            transform 0.6s ease var(--delay),
            border-color 0.2s,
            box-shadow 0.2s;
    }
    .gallery-item.in {
        opacity: 1;
        transform: none;
    }
    .gallery-item:hover,
    .gallery-item:focus-visible {
        border-color: var(--accent);
        box-shadow: 6px 6px 0 var(--accent-shadow), 0 0 28px rgba(var(--accent-rgb), 0.35);
        outline: none;
    }
    .gallery-img {
        transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.6s;
    }
    .gallery-item:hover .gallery-img {
        transform: scale(1.06);
        filter: saturate(1.15);
    }

    /* ---- popup ---- */
    .lightbox {
        /* 100% rather than 100vw, so the popup stops at the page scrollbar instead of sliding under it */
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        margin: 0;
        padding: 0;
        border: none;
        background: transparent;
        color: white;
        opacity: 0;
        transition: opacity 0.25s ease;
    }
    .lightbox::backdrop {
        background: rgba(5, 5, 8, 0.94);
        backdrop-filter: blur(6px);
    }
    .lightbox.show {
        opacity: 1;
    }
    .lightbox-stage {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 64px 16px;
    }
    .lightbox-figure {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        max-width: 100%;
        max-height: 100%;
        transform: scale(0.94);
        transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .lightbox.show .lightbox-figure {
        transform: none;
    }
    .lightbox-img {
        max-width: min(92vw, 1600px);
        max-height: calc(100dvh - 170px);
        object-fit: contain;
        border: 2px solid var(--accent);
        box-shadow: 8px 8px 0 var(--accent-shadow), 0 0 60px rgba(var(--accent-rgb), 0.25);
        transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .lightbox-img.swap {
        opacity: 0;
        transform: scale(0.98);
    }
    .lightbox-caption {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: #ddd;
        text-align: center;
    }
    .lightbox-caption:empty {
        display: none;
    }
    .lightbox-counter {
        position: absolute;
        top: 20px;
        left: 20px;
        font-family: monospace;
        font-size: 12px;
        letter-spacing: 0.2em;
        color: #888;
    }
    .lightbox-btn {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: 2px solid var(--accent);
        background: rgba(10, 10, 10, 0.8);
        color: white;
        cursor: pointer;
        transition: background 0.15s, color 0.15s, transform 0.15s;
    }
    .lightbox-btn[hidden] {
        display: none;
    }
    .lightbox-btn:hover {
        background: var(--accent);
        color: black;
    }
    .lightbox-close {
        top: 12px;
        right: 12px;
    }
    .lightbox-prev,
    .lightbox-next {
        top: 50%;
        transform: translateY(-50%);
    }
    .lightbox-prev { left: 16px; }
    .lightbox-next { right: 16px; }
    .lightbox-prev:hover { transform: translate(-3px, -50%); }
    .lightbox-next:hover { transform: translate(3px, -50%); }

    @media (max-width: 640px) {
        .lightbox-prev,
        .lightbox-next {
            top: auto;
            bottom: 16px;
            transform: none;
        }
        .lightbox-prev:hover,
        .lightbox-next:hover {
            transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .gallery-item,
        .gallery-img,
        .lightbox,
        .lightbox-figure,
        .lightbox-img {
            transition: none;
        }
        .gallery-item {
            opacity: 1;
            transform: none;
        }
    }
</style>

<script>
    function setupGallery(root: HTMLElement) {
        const gallery = root.querySelector<HTMLElement>(".photo-gallery");
        const dialog = root.querySelector<HTMLDialogElement>(".lightbox");
        if (!gallery || !dialog || root.dataset.bound) return;
        root.dataset.bound = "true";

        const items = [...gallery.querySelectorAll<HTMLButtonElement>(".gallery-item")];
        const img = dialog.querySelector<HTMLImageElement>(".lightbox-img")!;
        const caption = dialog.querySelector<HTMLElement>(".lightbox-caption")!;
        const counter = dialog.querySelector<HTMLElement>(".lightbox-counter")!;
        const multiple = items.length > 1;
        let index = 0;

        dialog.querySelectorAll<HTMLElement>(".lightbox-prev, .lightbox-next").forEach((btn) => {
            btn.hidden = !multiple;
        });

        // Fade photos in as they scroll into view
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    entry.target.classList.add("in");
                    observer.unobserve(entry.target);
                }
            },
            { rootMargin: "0px 0px -40px 0px" },
        );
        items.forEach((item) => observer.observe(item));

        function preload(i: number) {
            const item = items[(i + items.length) % items.length];
            if (item) new Image().src = item.dataset.full!;
        }

        function show(i: number, animate = true) {
            index = (i + items.length) % items.length;
            const item = items[index];
            const apply = () => {
                img.src = item.dataset.full!;
                img.alt = item.dataset.caption ?? "";
                caption.textContent = item.dataset.caption ?? "";
                counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}`;
                img.classList.remove("swap");
            };
            if (!animate) return apply();
            img.classList.add("swap");
            setTimeout(apply, 150);
            preload(index + 1);
            preload(index - 1);
        }

        function open(i: number) {
            show(i, false);
            dialog!.showModal();
            requestAnimationFrame(() => dialog!.classList.add("show"));
            preload(i + 1);
            preload(i - 1);
        }

        function close() {
            dialog!.classList.remove("show");
            setTimeout(() => dialog!.close(), 200);
        }

        items.forEach((item, i) => item.addEventListener("click", () => open(i)));
        dialog.querySelector(".lightbox-close")!.addEventListener("click", close);
        dialog.querySelector(".lightbox-prev")!.addEventListener("click", () => show(index - 1));
        dialog.querySelector(".lightbox-next")!.addEventListener("click", () => show(index + 1));

        // Clicking the dark area around the photo closes it
        dialog.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (target === dialog || target.classList.contains("lightbox-stage")) close();
        });

        dialog.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                e.preventDefault();
                close();
            } else if (multiple && e.key === "ArrowLeft") show(index - 1);
            else if (multiple && e.key === "ArrowRight") show(index + 1);
        });

        // Swipe left / right on touch screens
        let touchX = 0;
        dialog.addEventListener("touchstart", (e) => (touchX = e.touches[0].clientX), { passive: true });
        dialog.addEventListener("touchend", (e) => {
            const dx = e.changedTouches[0].clientX - touchX;
            if (multiple && Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
        });
    }

    function setupGalleries() {
        document.querySelectorAll<HTMLElement>(".gallery-root").forEach(setupGallery);
    }

    setupGalleries();
    document.addEventListener("astro:page-load", setupGalleries);
</script>
