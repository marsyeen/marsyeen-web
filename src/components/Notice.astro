---
/**
 * Alert box. Usage:
 *   <Notice type="success" title="Booked!">See you there.</Notice>
 * type: "info" (default) | "success" | "warning" | "error"; title defaults to the type's name.
 */
import { Info, CircleCheck, TriangleAlert, OctagonAlert } from "@lucide/astro";

type NoticeType = "info" | "success" | "warning" | "error";

interface Props {
    type?: NoticeType;
    title?: string;
    class?: string;
}

const STYLES = {
    info: { icon: Info, label: "Info", color: "#3b82f6", rgb: "59, 130, 246", shadow: "#1e3a8a" },
    success: { icon: CircleCheck, label: "Success", color: "#22c55e", rgb: "34, 197, 94", shadow: "#14532d" },
    warning: { icon: TriangleAlert, label: "Warning", color: "#f59e0b", rgb: "245, 158, 11", shadow: "#78350f" },
    error: { icon: OctagonAlert, label: "Error", color: "#ef4444", rgb: "239, 68, 68", shadow: "#7f1d1d" },
} as const;

const { type = "info", title, class: className } = Astro.props;
const { icon: Icon, label, color, rgb, shadow } = STYLES[type];
const urgent = type === "warning" || type === "error";
---

<div
    class:list={["notice relative flex items-start gap-5 p-6 sm:p-7 overflow-hidden", className]}
    style={`--n-color:${color}; --n-rgb:${rgb}; --n-shadow:${shadow};`}
    role={urgent ? "alert" : "status"}
>
    <div class="notice-icon relative shrink-0 flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14">
        <Icon size={28} />
    </div>

    <div class="relative min-w-0 pt-0.5">
        <p class="notice-title text-[14px] sm:text-[15px] font-bold tracking-[0.2em] uppercase mb-2">
            {title ?? label}
        </p>
        <div class="text-[#e5e5e5] text-base sm:text-[17px] leading-relaxed">
            <slot />
        </div>
    </div>
</div>

<style>
    .notice {
        border: 2px solid var(--n-color);
        background:
            linear-gradient(115deg, rgba(var(--n-rgb), 0.18) 0%, rgba(var(--n-rgb), 0.05) 45%, transparent 75%),
            #0a0a0a;
        box-shadow:
            6px 6px 0 var(--n-shadow),
            0 0 32px rgba(var(--n-rgb), 0.18);
        animation: noticeIn 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    /* Thick colour stripe down the left edge */
    .notice::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 6px;
        background: var(--n-color);
        box-shadow: 0 0 16px rgba(var(--n-rgb), 0.8);
    }

    /* Light sheen that sweeps across every few seconds */
    .notice::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.07) 50%, transparent 70%);
        transform: translateX(-100%);
        animation: noticeSheen 5s ease-in-out 1s infinite;
        pointer-events: none;
    }

    .notice-icon {
        color: var(--n-color);
        border: 2px solid var(--n-color);
        background: rgba(var(--n-rgb), 0.12);
        box-shadow:
            3px 3px 0 var(--n-shadow),
            0 0 18px rgba(var(--n-rgb), 0.45),
            inset 0 0 12px rgba(var(--n-rgb), 0.25);
    }

    .notice-title {
        color: var(--n-color);
        text-shadow: 0 0 12px rgba(var(--n-rgb), 0.55);
    }

    @keyframes noticeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
    }

    @keyframes noticeSheen {
        0%, 60% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }

    @media (prefers-reduced-motion: reduce) {
        .notice,
        .notice::after {
            animation: none;
        }
    }
</style>
