---
interface Props {
  src: string;
  eyebrow?: string;
  subtitle: string;
}

const { src, eyebrow, subtitle } = Astro.props;
---

<header class="hero relative min-h-[420px] sm:min-h-[460px] flex items-end overflow-hidden border-b-2 border-[var(--accent)] shadow-[0_4px_0_var(--accent-shadow)]">
  <img src={src} alt="" class="hero-img absolute inset-0 w-full h-full object-cover object-center" />
  <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-black/20" />
  <div class="absolute inset-0 bg-gradient-to-t from-[#0f0f0f] via-transparent to-transparent" />

  <div class="relative w-full max-w-6xl mx-auto px-6 lg:px-8 pt-28 pb-12">
    <h1 class="hero-title text-5xl sm:text-7xl font-bold text-white leading-[0.95] [text-shadow:0_4px_24px_rgba(0,0,0,0.6)]">
      <slot />
    </h1>

    <div class="hero-meta flex items-center gap-4 mt-6 mb-5">
      <span class="hero-bar block h-[3px] w-14 bg-[var(--accent)] shadow-[2px_2px_0_var(--accent-shadow)]" />
      {eyebrow && (
        <span class="text-[11px] sm:text-[12px] font-bold tracking-[0.3em] uppercase text-[#bbb]">
          {eyebrow}
        </span>
      )}
    </div>

    <p class="hero-subtitle text-[#ccc] text-base sm:text-lg max-w-xl leading-relaxed">
      {subtitle}
    </p>
  </div>
</header>

<style>
  .hero-img {
    transform: scale(1.08);
    animation: heroZoomOut 1.4s ease-out forwards;
  }

  .hero-title,
  .hero-meta,
  .hero-subtitle {
    opacity: 0;
    transform: translateY(16px);
    animation: heroFadeUp 0.5s ease-out forwards;
  }
  .hero-title { animation-delay: 0.2s; }
  .hero-meta { animation-delay: 0.35s; }
  .hero-subtitle { animation-delay: 0.5s; }

  .hero-bar {
    transform: scaleX(0);
    transform-origin: left;
    animation: heroScaleX 0.4s ease-out 0.45s forwards;
  }

  @keyframes heroZoomOut {
    to { transform: scale(1); }
  }

  @keyframes heroFadeUp {
    to { opacity: 1; transform: none; }
  }

  @keyframes heroScaleX {
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-img,
    .hero-title,
    .hero-meta,
    .hero-subtitle,
    .hero-bar {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
