---
import { Menu, X } from "@lucide/astro";

interface Props {
    transparent?: boolean;
}

const { transparent = false } = Astro.props;

const links = [
    { href: "/", label: "Home" },
    { href: "/about", label: "About" },
    { href: "/blog", label: "Blog" },
    { href: "/adventures", label: "Adventures" },
    { href: "/socials", label: "Socials" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
    class:list={[
        "navbar relative sticky top-0 z-50 transition-colors duration-300",
        transparent
            ? "border-b-2 border-transparent bg-transparent"
            : "border-b-2 border-[var(--accent)] bg-[#0a0a0a]/95 backdrop-blur",
    ]}
>
    <nav
        class="max-w-6xl mx-auto px-6 lg:px-8 h-16 flex items-center justify-between"
    >
        <a
            href="/"
            class="flex items-center gap-2 font-bold text-white tracking-wide"
        >
            <span data-theme-name>Mars</span>
        </a>

        {/* Desktop links */}
        <ul class="hidden sm:flex items-center gap-8">
            {
                links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            aria-current={
                                current === link.href ? "page" : undefined
                            }
                            class:list={[
                                "text-[13px] font-bold tracking-widest uppercase transition-colors",
                                current === link.href
                                    ? "text-[var(--accent)]"
                                    : "text-[#888] hover:text-white",
                            ]}
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        {/* Mobile toggle */}
        <button
            type="button"
            class="nav-toggle sm:hidden relative inline-flex items-center justify-center w-10 h-10 border-2 border-[var(--accent)] text-white transition-transform duration-150 active:scale-90"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <span class="relative w-5 h-5">
                <Menu
                    size={20}
                    class="icon-open absolute inset-0 transition-all duration-200"
                />
                <X
                    size={20}
                    class="icon-close absolute inset-0 transition-all duration-200 opacity-0 scale-50 rotate-45"
                />
            </span>
        </button>
    </nav>

    {/* Mobile menu */}
    <div
        class="mobile-menu-wrapper sm:hidden absolute left-0 right-0 top-full grid transition-[grid-template-rows] duration-300 ease-out"
        style="grid-template-rows: 0fr;"
    >
        <div class="overflow-hidden">
            <ul
                id="mobile-menu"
                class="flex flex-col border-t-2 border-b-2 border-[var(--accent)] bg-[#0a0a0a] px-6 py-2 gap-0.5 shadow-[0_4px_0_var(--accent-shadow)]"
            >
                {
                    links.map((link, i) => (
                        <li
                            class="menu-item opacity-0 -translate-x-2 transition-all duration-200 ease-out"
                            style={`transition-delay: ${i * 40}ms`}
                        >
                            <a
                                href={link.href}
                                aria-current={
                                    current === link.href ? "page" : undefined
                                }
                                class:list={[
                                    "block py-2.5 text-[13px] font-bold tracking-widest uppercase transition-colors",
                                    current === link.href
                                        ? "text-[var(--accent)]"
                                        : "text-[#888] hover:text-white",
                                ]}
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</header>

<script>
    function setupNavbar() {
        const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
        const wrapper = document.querySelector<HTMLElement>(
            ".mobile-menu-wrapper",
        );
        const menu = document.querySelector<HTMLElement>("#mobile-menu");
        if (!toggle || !wrapper || !menu || toggle.dataset.bound) return;
        toggle.dataset.bound = "true";

        const iconOpen = toggle.querySelector<HTMLElement>(".icon-open");
        const iconClose = toggle.querySelector<HTMLElement>(".icon-close");
        const items = menu.querySelectorAll<HTMLElement>(".menu-item");

        function setOpen(open: boolean) {
            wrapper!.style.gridTemplateRows = open ? "1fr" : "0fr";
            toggle!.setAttribute("aria-expanded", String(open));

            iconOpen?.classList.toggle("opacity-0", open);
            iconOpen?.classList.toggle("scale-50", open);
            iconOpen?.classList.toggle("-rotate-45", open);
            iconClose?.classList.toggle("opacity-0", !open);
            iconClose?.classList.toggle("scale-50", !open);
            iconClose?.classList.toggle("rotate-45", !open);

            items.forEach((item) => {
                item.classList.toggle("opacity-0", !open);
                item.classList.toggle("-translate-x-2", !open);
            });
        }

        toggle.addEventListener("click", () => {
            setOpen(wrapper!.style.gridTemplateRows !== "1fr");
        });

        menu.querySelectorAll("a").forEach((a) => {
            a.addEventListener("click", () => setOpen(false));
        });
    }

    setupNavbar();
    document.addEventListener("astro:after-swap", setupNavbar);
</script>

<script>
    // The site name follows the theme: Mars (orange) or Lynix (purple)
    function applySiteName() {
        const name = document.documentElement.dataset.theme === "lynix" ? "Lynix" : "Mars";
        document.querySelectorAll<HTMLElement>("[data-theme-name]").forEach((el) => (el.textContent = name));
        document.querySelectorAll<HTMLElement>("[data-theme-alt]").forEach((el) => el.setAttribute("alt", `${name} Fursona`));
        document.querySelectorAll<HTMLImageElement>("[data-src-mars]").forEach((el) => {
            const src = name === "Lynix" ? el.dataset.srcLynix : el.dataset.srcMars;
            if (src && el.getAttribute("src") !== src) el.setAttribute("src", src);
        });
        document.querySelectorAll<HTMLElement>("[data-theme-text]").forEach((el) => {
            const text = name === "Lynix" ? el.dataset.lynix : el.dataset.mars;
            if (text) el.textContent = text;
        });
    }
    applySiteName();
    document.addEventListener("theme:change", applySiteName);
    document.addEventListener("astro:page-load", applySiteName);
</script>
