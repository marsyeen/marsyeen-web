---
/** Site-wide announcement strip shown directly under the navbar. */
import { Info } from "@lucide/astro";

interface Props {
    /** Render as a floating card instead of a full-width bar (for pages with a transparent navbar). */
    floating?: boolean;
}

const { floating = false } = Astro.props;
---

<div
    class:list={[
        "relative z-40 bg-[#0f2147]",
        floating
            ? "mx-6 lg:mx-auto lg:max-w-4xl mt-2 border-2 border-[#3b82f6] shadow-[4px_4px_0_#1e3a8a]"
            : "border-b-2 border-[#3b82f6]",
    ]}
    role="status"
>
    <div class:list={["flex items-start gap-3 py-3", floating ? "px-5" : "max-w-6xl mx-auto px-6 lg:px-8"]}>
        <Info size={18} class="shrink-0 text-[#60a5fa] mt-0.5" />
        <p class="text-[12px] sm:text-[13px] leading-relaxed text-[#e5e5e5]">
            <span class="font-bold tracking-[0.15em] uppercase text-[#60a5fa] mr-1">Instagram update:</span>
            Thank you to everyone who reached out about my main account being disabled. I'm still working on
            getting it recovered. In the meantime you can follow me at{" "}
            <a
                href="https://instagram.com/mars_eats_sand"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold text-[#60a5fa] underline underline-offset-2 hover:text-white">@mars_eats_sand</a
            >, though that account may not stick around forever. Let's hope the main one comes back :3
        </p>
    </div>
</div>
