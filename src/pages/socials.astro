---

<Layout title="Socials">
    <main class="flex-1 relative z-10">
        <HeroBanner
            src="/socials.jpg"
            eyebrow="Find me online"
            subtitle="I'm scattered across the universe. Pick your platform or just send a cargo ship, either works."
        >
            Socials
        </HeroBanner>

        <div class="max-w-5xl mx-auto w-full px-6 lg:px-8 py-20 space-y-20">
            {
                categories.map((category, i) => {
                    const items = socials.filter((s) => s.category === category);
                    return (
                        <section>
                            <div class="flex items-center gap-4 mb-8">
                                <span class="text-[var(--accent)] text-sm font-bold tracking-[0.25em]">
                                    {String(i + 1).padStart(2, "0")}
                                </span>
                                <h2 class="text-2xl sm:text-3xl font-bold text-white uppercase tracking-wider">
                                    {category}
                                </h2>
                                <span class="flex-1 h-0.5 bg-gradient-to-r from-[#333] to-transparent" />
                                <span class="text-[#555] text-xs font-bold tracking-[0.2em]">
                                    {items.length} LINKS
                                </span>
                            </div>

                            <div
                                class:list={[
                                    "grid gap-5",
                                    items.length % 3 === 0 ? "md:grid-cols-3" : "sm:grid-cols-2",
                                ]}
                            >
                                {items.map((s) => (
                                    <a
                                        href={s.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="social-card group relative flex flex-col overflow-hidden bg-[#0a0a0a]"
                                        style={`--c: ${s.color}`}
                                    >
                                        {s.notice && (
                                            <div
                                                class:list={[
                                                    "flex items-center gap-2 px-4 py-2 border-b-2 text-[11px] font-bold leading-snug",
                                                    s.noticeType === "error"
                                                        ? "bg-[#ef4444]/15 border-[#ef4444] text-[#f87171]"
                                                        : "bg-[#f59e0b]/15 border-[#f59e0b] text-[#fbbf24]",
                                                ]}
                                            >
                                                <TriangleAlert size={14} class="shrink-0" />
                                                <span>{s.notice}</span>
                                            </div>
                                        )}

                                        <div class="flex-1 flex items-center gap-5 p-6">
                                            <div class="social-icon shrink-0 flex items-center justify-center w-16 h-16">
                                                <svg
                                                    class="w-8 h-8"
                                                    viewBox="0 0 24 24"
                                                    fill="currentColor"
                                                    set:html={s.icon}
                                                />
                                            </div>

                                            <div class="min-w-0 flex-1">
                                                <p class="text-[11px] font-bold tracking-[0.2em] uppercase text-[#777] group-hover:text-[var(--c)] transition-colors">
                                                    {s.name}
                                                </p>
                                                <p class="text-white font-bold text-base sm:text-lg truncate">
                                                    {s.handle}
                                                </p>
                                            </div>
                                        </div>

                                        <div class="mt-auto flex items-center justify-between px-6 py-3 border-t-2 border-[#1f1f1f] text-[11px] font-bold tracking-widest uppercase text-[#777] group-hover:text-white transition-colors">
                                            <span>{s.cta}</span>
                                            <span class="transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 text-[var(--c)]">
                                                ↗
                                            </span>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </section>
                    );
                })
            }
        </div>
    </main>
</Layout>

<style>
    .social-card {
        border: 2px solid #2a2a2a;
        box-shadow: 4px 4px 0 transparent;
        transition:
            border-color 150ms,
            box-shadow 150ms,
            transform 150ms;
    }

    /* Brand-colour stripe along the top edge */
    .social-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: var(--c);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 250ms ease-out;
    }

    .social-card:hover {
        border-color: var(--c);
        box-shadow:
            5px 5px 0 color-mix(in srgb, var(--c) 35%, #000),
            0 0 28px color-mix(in srgb, var(--c) 20%, transparent);
        transform: translate(-2px, -2px);
    }

    .social-card:hover::before {
        transform: scaleX(1);
    }

    .social-icon {
        color: var(--c);
        border: 2px solid color-mix(in srgb, var(--c) 45%, #000);
        background: color-mix(in srgb, var(--c) 10%, transparent);
        transition: box-shadow 150ms;
    }

    .social-card:hover .social-icon {
        box-shadow: 0 0 18px color-mix(in srgb, var(--c) 45%, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
        .social-card,
        .social-card::before {
            transition: none;
        }
    }
</style>
