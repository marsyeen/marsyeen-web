---

<Layout title="Socials">
  <main class="flex-1 relative z-10">
    <HeroBanner
      src="/imgs/banner-socials.jpg"
      eyebrow="Find me online"
      subtitle="I'm scattered across the universe. Pick your platform — or just send a cargo ship, either works."
    >
      Socials
    </HeroBanner>

    <div class="max-w-6xl mx-auto w-full px-6 lg:px-8 py-20">
      {/* Categories */}
      {
        categories.map((category, i) => (
          <div class:list={[i > 0 && "mt-16"]}>
            <p class="text-[12px] font-bold tracking-[0.25em] uppercase text-[var(--accent)] mb-2">
              Category
            </p>
            <h2 class="text-3xl font-bold text-white mb-8">{category}</h2>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {socials
                .filter((s) => s.category === category)
                .map((s) => (
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group relative flex flex-col border-2 border-[#333] bg-[#0a0a0a] p-6
                hover:border-[var(--accent)] shadow-[4px_4px_0_transparent]
                hover:shadow-[4px_4px_0_var(--accent-shadow)]
                hover:-translate-x-0.5 hover:-translate-y-0.5
                transition-all duration-150"
                  >
                    <div class="flex items-start justify-between mb-5">
                      <div
                        class="p-3 border-2 border-[#333] group-hover:border-current transition-colors"
                        style={`color: ${s.color}`}
                      >
                        <svg
                          class="w-8 h-8"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          set:html={s.icon}
                        />
                      </div>

                      <span class="text-[#555] group-hover:text-[var(--accent)] text-lg transition-colors leading-none mt-1">
                        ↗
                      </span>
                    </div>

                    <p
                      class="text-[12px] font-bold tracking-[0.2em] uppercase text-[#777] mb-1
                group-hover:text-[var(--accent)] transition-colors"
                    >
                      {s.name}
                    </p>
                    <p class="text-white font-bold text-[15px] mb-3">
                      {s.handle}
                    </p>

                    <p class="text-[#888] text-[12px] leading-relaxed flex-1 mb-5">
                      {s.desc}
                    </p>

                    <div
                      class="flex items-center gap-2 text-[11px] font-bold tracking-widest uppercase
                text-[#777] group-hover:text-[var(--accent)] transition-colors"
                    >
                      <span>{s.cta}</span>
                      <span class="transition-transform group-hover:translate-x-1">
                        →
                      </span>
                    </div>
                  </a>
                ))}
            </div>
          </div>
        ))
      }
    </div>
  </main>
</Layout>
