---
import Layout from "../layouts/Layout.astro";
import ProfileAvatar from "../components/ProfileAvatar.astro";
import { MessagesSquare, PawPrint } from "@lucide/astro";

const buttonBase =
    "inline-flex items-center gap-2 font-bold py-3 px-6 border-2 transition-all duration-100 cursor-pointer select-none shadow-[4px_4px_0_var(--accent-shadow)] hover:shadow-[2px_2px_0_var(--accent-shadow)] hover:translate-x-0.5 hover:translate-y-0.5 active:shadow-none active:translate-x-1 active:translate-y-1";
---

<Layout transparentNav>
    <main class="relative z-10 flex-1 flex flex-col justify-center">
        <div class="w-full max-w-3xl mx-auto px-6 lg:px-8 py-14 text-center">
            <div class="anim-fade" style="animation-delay: 0.2s">
                <ProfileAvatar />
            </div>

            <h1
                class="anim-fade text-5xl sm:text-7xl font-extrabold tracking-tight leading-none"
                style="animation-delay: 0.3s"
            >
                Hey, I'm <span class="text-[var(--accent)]" data-theme-name>Mars</span>!
            </h1>

            <p
                class="anim-fade glow-text mt-6 text-base sm:text-xl font-extrabold tracking-[0.12em] uppercase"
                style="animation-delay: 0.4s"
            >
                I'm Driven by Curiosity, Fueled by Passion
            </p>

            <p
                class="anim-fade max-w-xl mx-auto mt-6 text-[#e5e5e5] leading-relaxed"
                style="animation-delay: 0.5s"
            >
                <span data-theme-text data-mars="Spotted hyena" data-lynix="Cosmic wolf">Spotted hyena</span> from Toronto! Loves adventuring,
                cybersecurity & IT, and VR. Huge space and aviation
                nerd!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
                <div class="anim-button" style="animation-delay: 0.6s">
                    <a
                        href="/socials"
                        class:list={[buttonBase, "bg-[var(--accent)] text-black border-[var(--accent-shadow)]"]}
                    >
                        <MessagesSquare size={20} />
                        Contact Me
                    </a>
                </div>
                <div class="anim-button" style="animation-delay: 0.75s">
                    <a
                        href="/about"
                        class:list={[buttonBase, "bg-transparent text-white border-[var(--accent)]"]}
                    >
                        <PawPrint size={20} />
                        My Fursona
                    </a>
                </div>
            </div>
        </div>

        <p class="text-[15px] text-[#888] fixed bottom-2 right-4 z-10">
            <strong>v4.0.1-earthbound+dev</strong>
        </p>
    </main>
</Layout>

<style>
    .anim-fade {
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9), 0 0 12px rgba(0, 0, 0, 0.7);
        opacity: 0;
        animation: fadeIn 0.5s ease-out forwards;
    }

    .anim-button {
        opacity: 0;
        transform: translateY(16px);
        animation: fadeUp 0.5s ease-out forwards;
    }

    /* Neon sign on its last legs: a softer glow that flickers and cuts out at random */
    .glow-text {
        color: var(--accent);
        text-shadow:
            0 1px 2px rgba(0, 0, 0, 0.9),
            0 0 3px var(--accent),
            0 0 10px var(--accent-shadow);
        animation: neonFlicker 7s linear infinite;
    }

    @keyframes neonFlicker {
        0%, 4%, 8%, 10%, 22%, 46%, 49%, 52%, 70%, 88%, 92%, 100% {
            opacity: 1;
            text-shadow:
                0 1px 2px rgba(0, 0, 0, 0.9),
                0 0 3px var(--accent),
                0 0 10px var(--accent-shadow);
        }
        2%, 6%, 9%, 47%, 50%, 90% {
            opacity: 0.5;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
        }
        3%, 21%, 51%, 89%, 91% {
            opacity: 0.75;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9), 0 0 2px var(--accent-shadow);
        }
        23%, 71% {
            opacity: 0.88;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9), 0 0 2px var(--accent);
        }
    }

    @keyframes fadeIn {
        to { opacity: 1; }
    }

    @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .anim-fade, .anim-button, .glow-text {
            opacity: 1;
            transform: none;
            animation: none;
        }
    }
</style>
