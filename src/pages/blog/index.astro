---
import Layout from "../../layouts/Layout.astro";
import HeroBanner from "../../components/HeroBanner.astro";
import { getCollection } from "astro:content";
import { CalendarDays, Tag } from "@lucide/astro";
import Notice from "../../components/Notice.astro";

const posts = (
    await getCollection("blog", ({ data }) =>
        (import.meta.env.PROD ? !data.draft : true) && !data.hidden,
    )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
});
---

<Layout title="Blog">
    <main class="flex-1 relative z-10">
        <HeroBanner
            src="/blog.jpg"
            eyebrow="Field Notes"
            subtitle="Con recaps, photography breakdowns, and whatever else is rattling around in my head this week."
        >
            Blog
        </HeroBanner>

        <div class="max-w-6xl mx-auto w-full px-6 lg:px-8 py-20">
            {
                posts.length === 0 ? (
                    <Notice title="No posts yet">
                        Check back soon!
                    </Notice>
                ) : (
                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                        {posts.map(({ id, data }) => (
                            <a
                                href={`/blog/${id}/`}
                                class="group flex flex-col border-2 border-[#333] bg-[#0a0a0a]
                hover:border-[var(--accent)] shadow-[4px_4px_0_transparent]
                hover:shadow-[4px_4px_0_var(--accent-shadow)]
                hover:-translate-x-0.5 hover:-translate-y-0.5
                transition-all duration-150"
                            >
                                {data.heroImage && (
                                    <div class="aspect-[4/3] overflow-hidden border-b-2 border-[#333] group-hover:border-[var(--accent)] transition-colors">
                                        <img
                                            src={data.heroImage}
                                            alt=""
                                            loading="lazy"
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                        />
                                    </div>
                                )}

                                <div class="flex flex-col flex-1 p-6">
                                    <div class="flex items-center gap-1.5 text-[11px] font-mono tracking-widest uppercase text-[#666] mb-3">
                                        <CalendarDays size={12} />
                                        <time datetime={data.pubDate.toISOString()}>{dateFormatter.format(data.pubDate)}</time>
                                    </div>

                                    <h2 class="text-xl font-bold text-white mb-2 group-hover:text-[var(--accent)] transition-colors">
                                        {data.title}
                                    </h2>
                                    <p class="text-[#888] text-[14px] leading-relaxed flex-1 mb-5">
                                        {data.description}
                                    </p>

                                    <div class="flex items-center gap-2 text-[11px] font-bold tracking-widest uppercase text-[#777] group-hover:text-[var(--accent)] transition-colors">
                                        {data.tags.length > 0 && (
                                            <>
                                                <Tag size={13} />
                                                <span class="truncate">{data.tags.join(" · ")}</span>
                                            </>
                                        )}
                                        <span class="ml-auto transition-transform group-hover:translate-x-1">→</span>
                                    </div>
                                </div>
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </main>
</Layout>
