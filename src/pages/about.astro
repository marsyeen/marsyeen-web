---
import Layout from '../layouts/Layout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import { MessagesSquare, ExternalLink } from '@lucide/astro';

const interests = [
  {
    icon: "📷",
    title: "Photography",
    desc: "Capturing moments at cons, on trails, and everywhere the adventure takes me.",
  },
  {
    icon: "🔐",
    title: "Cybersecurity / IT",
    desc: "Digging into systems, finding the gaps, and keeping things locked down.",
  },
  {
    icon: "💻",
    title: "Programming",
    desc: "Building fun projects, automating the boring stuff, and always learning new tech.",
  },
];

const characters = [
  {
    id: "mars",
    name: "Mars",
    accent: "#ff6b1a",
    shadow: "#7a3200",
    kicker: "The hyena himself",
    headingPrefix: "Greetings! I'm ",
    image: "/imgs/pfp.png",
    bio: [
      "I'm Mars, a spotted hyena from Ontario, Canada. I'm passionate about photography, cybersecurity and adventuring to new places. I'm pretty much always on the move, hitting up as many furry conventions or sidequests as I can manage.",
      "The biggest highlight lately? FWA 2026 — where I finally made the jump to my first-ever fullbody suit. Catch me at a con? Definitely don't be a stranger.",
    ],
    cta: { label: "Get in touch", href: "/socials", icon: "message", external: false },
    stats: [
      { label: "Character", value: "Mars — Spotted Hyena" },
      { label: "Pronouns", value: "He / Him" },
      { label: "Fursona since", value: "May 2026" },
      { label: "Suit Type", value: "Fullbody" },
      { label: "Built by", value: "Pawie Paws" },
      { label: "Origin", value: "Mexico" },
      { label: "NetTuffs Compatible", value: "Yes" },
      { label: "NetTuffs Version", value: "3.1" },
    ],
    suit: {
      kicker: "The Suit",
      heading: "Meet Mars in the Fur",
      sub: "Mars is quite a character — here's what makes him tick.",
    },
    palette: [
      { label: "Primary Fur", hex: "#c9a06c" },
      { label: "Spots", hex: "#2b2b2b" },
      { label: "Underbelly", hex: "#f0e6d2" },
      { label: "Eyes", hex: "#4CAF50" },
      { label: "Suit Trim", hex: "#ff6b1a" },
    ],
    misc: [
      "Fursona since May 2026 — still getting used to the ears.",
      "Fullbody suit built by Pawie Paws, NetTuffs 3.1 compatible.",
      "Usually found behind a camera or a keyboard, sometimes both.",
    ],
    originLore: {
      intro: "Mars is an interstellar spotted hyena from the Iurin system, part of Sector 33. The Iurin system is a masterpiece of celestial architecture, tucked away in the jagged outskirts of Sector 33. It's not just a collection of planets; it's a high-energy environment that has shaped the very biology and culture of the",
      glitchWord: "Iurinnn-Lurinrriur@@@!!n",
      corrupted: "[CORRUPTED DATA ---- END]",
      note: "There's more to Mars than meets the eye... Coming Soon.",
    },
  },
  {
    id: "lynix",
    name: "Lynix",
    accent: "#a855f7",
    shadow: "#3b0764",
    kicker: "The purple side of me",
    headingPrefix: "Meet ",
    image: null,
    bio: [
      "Lynix is my other fursona — a purple anthropomorphic space wolf, drifting between star systems and conventions right alongside Mars. Sharp-eyed, a little mischievous, and impossible to miss in a crowd thanks to that unmistakable violet fur.",
    ],
    cta: { label: "Visit Lynix.ca", href: "https://lynix.ca", icon: "external", external: true },
    stats: [
      { label: "Name", value: "Lynix" },
      { label: "Species", value: "Wolf" },
      { label: "Fur Color", value: "Purple, White, Black" },
      { label: "Origin", value: "Somewhere among the stars" },
    ],
    suit: {
      kicker: "The Fit",
      heading: "Lynix's Ref Photos",
      sub: "Suit and reference shots — added as they're ready.",
    },
    palette: [
      { label: "Primary Fur", hex: "#a855f7" },
      { label: "Secondary Fur", hex: "#6d28d9" },
      { label: "Underbelly", hex: "#e9d5ff" },
      { label: "Eyes", hex: "#22d3ee" },
      { label: "Nose / Pads", hex: "#1e1b2e" },
    ],
    misc: [
      "Purple, white, and black colouring — no two patches quite the same.",
      "Lore's still being written — more on Lynix's story coming soon.",
      "No suit yet — reference photos will land here as the fursona develops.",
    ],
    originLore: null,
  },
];
---

<Layout title="About">
  <main class="flex-1 relative z-10">
    <HeroBanner
      src="/imgs/bg-new.jpg"
      eyebrow="Yip Yap?"
      subtitle="Spotted hyena. Space wolf. Photographer. Cyber nerd. Always on the move — catch me at a con or somewhere I probably shouldn't be."
    >
      Welcome to<br /><span class="text-[var(--accent)]">My Den</span>
    </HeroBanner>

    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-20">

      {/* ── Passions (shared) ── */}
      <div>
        <p class="text-[12px] font-bold tracking-[0.25em] uppercase text-[var(--accent)] mb-2">
          Passions
        </p>
        <h2 class="text-3xl font-bold text-white mb-1">What I'm Into</h2>
        <p class="text-[#777] text-sm mb-8 mt-1">The things that keep me busy, no matter whose fur I'm in.</p>

        <div class="grid sm:grid-cols-3 gap-4">
          {interests.map(({ icon, title, desc }) => (
            <div class="border-2 border-[#333] bg-[#0a0a0a] p-6
              hover:border-[var(--accent)] hover:shadow-[4px_4px_0_var(--accent-shadow)] transition-all group">
              <div class="text-2xl mb-4">{icon}</div>
              <h3 class="text-[11px] font-bold tracking-widest uppercase text-[var(--accent)] mb-2 group-hover:text-white transition-colors">
                {title}
              </h3>
              <p class="text-[#aaa] text-sm leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* ── Fursona tab switcher (full-bleed, 50/50 split) ── */}
    <div class="w-full grid grid-cols-2" role="tablist" aria-label="Fursona refsheets">
      {characters.map((c, i) => (
        <button
          type="button"
          role="tab"
          data-tab-btn={c.id}
          aria-selected={i === 0 ? "true" : "false"}
          style={`--accent:${c.accent};--shadow:${c.shadow}`}
          class:list={[
            "tab-btn w-full font-bold uppercase tracking-widest text-[14px] py-5 border-2 border-[var(--accent)] transition-all duration-100",
            i === 0
              ? "bg-[var(--accent)] text-black shadow-[inset_0_-4px_0_var(--shadow)]"
              : "bg-transparent text-[var(--accent)]",
          ]}
        >
          {c.name}
        </button>
      ))}
    </div>

    {/* ── Fursona wash intros (full-bleed, one per tab) ── */}
    {characters.map((c, i) => (
      <div
        data-tab-panel={c.id}
        class:list={["w-full border-y-2 border-[var(--accent)]", i === 0 ? "" : "hidden"]}
        style={`--accent:${c.accent};--shadow:${c.shadow}; background:linear-gradient(180deg, ${c.accent}22 0%, #0a0a0a 100%);`}
      >
        <div class="max-w-6xl mx-auto px-6 lg:px-8 py-16 grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="text-[12px] font-bold tracking-[0.25em] uppercase text-[var(--accent)] mb-2">
              {c.kicker}
            </p>
            <h2 class="text-3xl font-bold text-white mb-1">
              {c.headingPrefix}<span class="text-[var(--accent)]">{c.name}</span>
            </h2>
            <div class="w-10 h-[2px] bg-[var(--accent)] mb-6 mt-3" />
            {c.bio.map((paragraph) => (
              <p class="text-[#aaa] leading-relaxed mb-4 text-[15px]">{paragraph}</p>
            ))}
            <a
              href={c.cta.href}
              target={c.cta.external ? "_blank" : undefined}
              rel={c.cta.external ? "noopener noreferrer" : undefined}
              class="inline-flex items-center gap-2 font-bold py-3 px-6 border-2 mt-2
                bg-[var(--accent)] text-black border-[var(--shadow)]
                shadow-[4px_4px_0_var(--shadow)] hover:shadow-[2px_2px_0_var(--shadow)]
                hover:translate-x-0.5 hover:translate-y-0.5
                active:shadow-none active:translate-x-1 active:translate-y-1
                transition-all duration-100 text-[13px] tracking-widest uppercase"
            >
              {c.cta.icon === "external" ? <ExternalLink size={16} /> : <MessagesSquare size={16} />}
              {c.cta.label}
            </a>
          </div>

          <div class="flex justify-center lg:justify-end">
            <div class="relative">
              <div class="absolute inset-0 bg-[var(--accent)]/20 blur-2xl" />
              {c.image ? (
                <img
                  src={c.image}
                  alt={`${c.name} Profile`}
                  class="relative w-[380px] h-[380px] max-w-full object-contain border-2 border-[var(--accent)]
                    shadow-[8px_8px_0_var(--shadow)] rotate-2 hover:rotate-0 transition-transform duration-300 bg-[#0a0a0a]"
                />
              ) : (
                <div class="relative w-[380px] h-[380px] max-w-full border-2 border-[var(--accent)]
                  shadow-[8px_8px_0_var(--shadow)] rotate-2 hover:rotate-0 transition-transform duration-300
                  bg-[#0a0a0a] flex items-center justify-center">
                  <span class="text-[var(--accent)]/60 text-[12px] font-mono tracking-widest uppercase text-center px-6">
                    Ref art<br />coming soon
                  </span>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}

    {/* ── Fursona refsheets (rest of content) ── */}
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-20">
      {characters.map((c, i) => (
        <div data-tab-panel={c.id} class:list={[i === 0 ? "" : "hidden"]} style={`--accent:${c.accent};--shadow:${c.shadow}`}>

          {/* Suit / Ref Photos + Quick Stats */}
          <div>
            <p class="text-[12px] font-bold tracking-[0.25em] uppercase text-[var(--accent)] mb-2">
              {c.suit.kicker}
            </p>
            <h2 class="text-3xl font-bold text-white mb-1">{c.suit.heading}</h2>
            <p class="text-[#777] text-sm mb-10 mt-1">{c.suit.sub}</p>

            <div class="grid lg:grid-cols-[1.5fr_1fr] gap-8 items-start">
              <div>
                <div class="relative aspect-[4/3] border-2 border-[var(--accent)] shadow-[4px_4px_0_var(--shadow)]
                  overflow-hidden mb-3 flex items-center justify-center bg-[#151515]">
                  <span class="text-[#555] text-[11px] font-mono tracking-widest uppercase">Photo coming soon</span>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  {[0, 1, 2].map(() => (
                    <div class="relative aspect-square border border-[#333] overflow-hidden
                      hover:border-[var(--accent)] transition-colors flex items-center justify-center bg-[#151515]">
                      <span class="text-[#444] text-lg">🐾</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="flex flex-col gap-2">
                {c.stats.map(({ label, value }) => (
                  <div class="flex items-center justify-between px-4 py-3 border border-[#333] bg-[#0a0a0a]
                    shadow-[2px_2px_0_var(--shadow)] hover:border-[var(--accent)] transition-colors group">
                    <span class="text-[12px] font-bold tracking-widest uppercase text-[#777] group-hover:text-[var(--accent)] transition-colors">
                      {label}
                    </span>
                    <span class="text-[13px] font-semibold text-white">{value}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="w-full h-px bg-[#333] my-16" />

          {/* Color Reference (for artists) */}
          <div>
            <p class="text-[12px] font-bold tracking-[0.25em] uppercase text-[var(--accent)] mb-2">
              For Artists
            </p>
            <h2 class="text-3xl font-bold text-white mb-1">Color Reference</h2>
            <p class="text-[#777] text-sm mb-8 mt-1">Swatches for commissions and fan art.</p>

            <div class="grid sm:grid-cols-2 gap-3">
              {c.palette.map(({ label, hex }) => (
                <div class="flex items-center gap-4 px-4 py-3 border border-[#333] bg-[#0a0a0a]
                  shadow-[2px_2px_0_var(--shadow)] hover:border-[var(--accent)] transition-colors">
                  <div class="w-10 h-10 flex-shrink-0 border-2 border-[#333] shadow-[2px_2px_0_var(--shadow)]" style={`background-color:${hex}`} />
                  <div class="flex-1 flex items-baseline justify-between">
                    <p class="text-white text-[13px] font-bold">{label}</p>
                    <p class="text-[#777] font-mono text-[11px]">{hex}</p>
                  </div>
                </div>
              ))}
            </div>
            <p class="text-[#666] text-[11px] font-mono mt-4 tracking-widest">
              // Reference only — confirm exact swatches before starting artwork.
            </p>
          </div>

          <div class="w-full h-px bg-[#333] my-16" />

          {/* Misc / Notes */}
          <div>
            <p class="text-[12px] font-bold tracking-[0.25em] uppercase text-[var(--accent)] mb-2">
              Misc
            </p>
            <h2 class="text-3xl font-bold text-white mb-1">Notes &amp; Trivia</h2>
            <div class="w-10 h-[2px] bg-[var(--accent)] mb-6 mt-3" />

            <ul class="space-y-3">
              {c.misc.map((item) => (
                <li class="flex items-start gap-3 text-[#aaa] text-[14px] leading-relaxed">
                  <span class="mt-[7px] w-1.5 h-1.5 flex-shrink-0 bg-[var(--accent)]" />
                  {item}
                </li>
              ))}
            </ul>
          </div>

          {/* Origin lore (Mars only) */}
          {c.originLore && (
            <>
              <div class="w-full h-px bg-[#333] my-16" />
              <div class="border-2 border-[var(--accent)] shadow-[4px_4px_0_var(--shadow)] p-8 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-0 h-0
                  border-t-[40px] border-t-[var(--accent)]
                  border-l-[40px] border-l-transparent" />

                <p class="text-[12px] font-bold tracking-[0.25em] uppercase text-[var(--accent)] mb-2">Lore</p>
                <h2 class="text-3xl font-bold text-white mb-1">Origin</h2>
                <div class="w-10 h-[2px] bg-[var(--accent)] mb-6 mt-3" />

                <p class="text-[#aaa] leading-relaxed text-[14px] mb-4">
                  {c.originLore.intro}{" "}
                  <span
                    class="glitch-text font-mono text-[var(--accent)] text-[12px]"
                    data-text={c.originLore.glitchWord}
                  >{c.originLore.glitchWord}</span>
                </p>

                <p class="font-mono text-[12px] tracking-widest mb-2">
                  <span
                    class="glitch-text text-[var(--accent)]"
                    data-text={c.originLore.corrupted}
                  >{c.originLore.corrupted}</span>
                </p>
                <p class="font-mono text-[#aaa] text-[11px] tracking-wider">
                  {c.originLore.note}
                </p>
              </div>
            </>
          )}

        </div>
      ))}

    </div>
  </main>
</Layout>

<script>
  import { getStoredTheme, setStoredTheme } from "../lib/theme";

  const GLITCH_CHARS = "!@#$%^&*<>?/\\|[]{}~`ABCDEFabcdef0123456789";

  function scramble(text: string, tick: number) {
    return text
      .split("")
      .map((ch) => {
        if (ch === " ") return " ";
        const glitchChance = tick % 8 === 0 ? 0.9 : 0.4;
        return Math.random() < glitchChance
          ? GLITCH_CHARS[Math.floor(Math.random() * GLITCH_CHARS.length)]
          : ch;
      })
      .join("");
  }

  function setupGlitchText() {
    document.querySelectorAll<HTMLElement>(".glitch-text").forEach((el) => {
      if (el.dataset.glitchBound) return;
      el.dataset.glitchBound = "true";

      const text = el.dataset.text ?? el.textContent ?? "";
      let tick = 0;
      setInterval(() => {
        tick++;
        el.textContent = scramble(text, tick);
      }, 80);
    });
  }

  function setupTabs() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-tab-btn]");
    const panels = document.querySelectorAll<HTMLElement>("[data-tab-panel]");

    function activate(id: string | undefined) {
      buttons.forEach((btn) => {
        const isActive = btn.dataset.tabBtn === id;
        btn.classList.toggle("bg-[var(--accent)]", isActive);
        btn.classList.toggle("text-black", isActive);
        btn.classList.toggle("shadow-[inset_0_-4px_0_var(--shadow)]", isActive);
        btn.classList.toggle("bg-transparent", !isActive);
        btn.classList.toggle("text-[var(--accent)]", !isActive);
        btn.setAttribute("aria-selected", String(isActive));
      });
      panels.forEach((panel) => {
        panel.classList.toggle("hidden", panel.dataset.tabPanel !== id);
      });
    }

    buttons.forEach((btn) => {
      if (btn.dataset.tabBound) return;
      btn.dataset.tabBound = "true";
      btn.addEventListener("click", () => {
        const id = btn.dataset.tabBtn;
        activate(id);
        if (id === "mars" || id === "lynix") {
          setStoredTheme(id);
        }
      });
    });

    activate(getStoredTheme());
  }

  setupGlitchText();
  setupTabs();
  document.addEventListener("astro:after-swap", setupGlitchText);
  document.addEventListener("astro:after-swap", setupTabs);
</script>
