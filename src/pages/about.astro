---
import Layout from "../layouts/Layout.astro";
import Notice from "../components/Notice.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { MessagesSquare, Camera, ShieldCheck, Trees, Copy } from "@lucide/astro";

const interests = [
    {
        icon: Camera,
        title: "Photography",
        desc: "Capturing moments at cons, on trails, and everywhere the adventure takes me.",
    },
    {
        icon: Trees,
        title: "Nature",
        desc: "Trails, lakes, and campsites — getting out past the city limits whenever I can.",
    },
    {
        icon: ShieldCheck,
        title: "Cybersecurity / IT",
        desc: "Digging into systems, finding the gaps, and keeping things locked down.",
    },
];

const characters = [
    {
        id: "mars",
        name: "Mars",
        file: "01",
        accent: "#ff6b1a",
        shadow: "#7a3200",
        kicker: "The hyena himself",
        image: "/about.jpg",
        bio: [
            "I'm Mars, a spotted hyena from Ontario, Canada. I'm passionate about photography, cybersecurity and adventuring to new places. I'm pretty much always on the move, hitting up as many furry conventions or sidequests as I can manage.",
            "The biggest highlight lately? FWA 2026 — where I finally made the jump to my first-ever fullbody suit. Catch me at a con? Definitely don't be a stranger.",
        ],
        notice: {
            type: "warning" as const,
            title: "Temporarily Decommissioned",
            body: "Due to deep cleaning, Mars is temporarily decommissioned from future events.",
        },
        stats: [
            { label: "Species", value: "Spotted Hyena" },
            { label: "Pronouns", value: "He / Him" },
            { label: "Fursona since", value: "May 2026" },
            { label: "Suit type", value: "Fullbody" },
            { label: "Built by", value: "Pawie Paws" },
            { label: "Origin", value: "Mexico" },
        ],
        photosHeading: "Mars in the fur",
        photos: ["/blog.jpg", "/about.jpg", "/bg.jpg", "/socials.jpg"],
        palette: [
            { label: "Primary Fur", hex: "#c9a06c" },
            { label: "Spots", hex: "#2b2b2b" },
            { label: "Underbelly", hex: "#f0e6d2" },
            { label: "Eyes", hex: "#4CAF50" },
            { label: "Suit Trim", hex: "#ff6b1a" },
        ],
        misc: [
            "Fursona since May 2026 — still getting used to the ears.",
            "Fullbody suit built by Pawie Paws, NetTuffs 3.1 compatible.",
            "Usually found behind a camera or a keyboard, sometimes both.",
        ],
        originLore: {
            intro: "Mars is an interstellar spotted hyena from the Iurin system, part of Sector 33. The Iurin system is a masterpiece of celestial architecture, tucked away in the jagged outskirts of Sector 33. It's not just a collection of planets; it's a high-energy environment that has shaped the very biology and culture of the",
            glitchWord: "Iurinnn-Lurinrriur@@@!!n",
            corrupted: "[CORRUPTED DATA ---- END]",
            note: "There's more to Mars than meets the eye... Coming Soon.",
        },
    },
    {
        id: "lynix",
        name: "Lynix",
        file: "02",
        accent: "#a855f7",
        shadow: "#3b0764",
        kicker: "The purple side of me",
        image: "/imgs/events.jpg",
        bio: [
            "Lynix is my other fursona — a purple anthropomorphic space wolf, drifting between star systems and conventions right alongside Mars. Sharp-eyed, a little mischievous, and impossible to miss in a crowd thanks to that unmistakable violet fur.",
        ],
        notice: null,
        stats: [
            { label: "Species", value: "Space Wolf" },
            { label: "Fur colour", value: "Purple, White, Black" },
            { label: "Origin", value: "Somewhere among the stars" },
            { label: "Suit", value: "Not yet" },
        ],
        photosHeading: "Lynix's ref photos",
        photos: ["/imgs/bark.jpg", "/imgs/train-arriving.jpg", "/imgs/banner3.jpg", "/imgs/test.jpg"],
        palette: [
            { label: "Primary Fur", hex: "#a855f7" },
            { label: "Secondary Fur", hex: "#6d28d9" },
            { label: "Underbelly", hex: "#e9d5ff" },
            { label: "Eyes", hex: "#22d3ee" },
            { label: "Nose / Pads", hex: "#1e1b2e" },
        ],
        misc: [
            "Purple, white, and black colouring — no two patches quite the same.",
            "Lore's still being written — more on Lynix's story coming soon.",
            "No suit yet — reference photos will land here as the fursona develops.",
        ],
        originLore: null,
    },
];
---

<Layout title="About">
    <main class="flex-1 relative z-10">
        {/* ── Intro: a terminal prompt instead of a photo banner ── */}
        <section class="max-w-6xl mx-auto px-6 lg:px-8 pt-20 sm:pt-28 pb-16">
            <p class="intro-line font-mono text-[13px] sm:text-sm text-[#888] mb-6" style="--d: 0s">
                <span class="text-[var(--accent)]">&gt;</span> whoami<span class="caret" aria-hidden="true">_</span>
            </p>
            <h1 class="intro-line text-5xl sm:text-7xl lg:text-8xl font-bold text-white leading-[0.95]" style="--d: 0.15s">
                Welcome to<br />
                <span class="text-[var(--accent)] [text-shadow:0_0_40px_rgba(var(--accent-rgb),0.45)]">my den.</span>
            </h1>
            <p class="intro-line mt-8 max-w-2xl text-lg sm:text-xl text-[#ccc] leading-relaxed" style="--d: 0.3s">
                Spotted hyena. Space wolf. Photographer. Cyber nerd. Always on the move — catch me at a con or
                somewhere I probably shouldn't be.
            </p>
            <p class="intro-line mt-8 font-mono text-[12px] tracking-[0.2em] uppercase text-[#666]" style="--d: 0.45s">
                2 files found · pick one below ↓
            </p>
        </section>

        {/* ── Character files ── */}
        <section class="max-w-6xl mx-auto px-6 lg:px-8 pb-24">
            <div class="flex items-end gap-2" role="tablist" aria-label="Fursonas">
                {characters.map((c, i) => (
                    <button
                        type="button"
                        role="tab"
                        data-tab-btn={c.id}
                        aria-selected={i === 0 ? "true" : "false"}
                        style={`--c:${c.accent}`}
                        class="file-tab"
                    >
                        <span class="font-mono text-[10px] opacity-70">FILE {c.file}</span>
                        <span>{c.name}</span>
                    </button>
                ))}
            </div>

            {characters.map((c, i) => (
                <div
                    data-tab-panel={c.id}
                    class:list={["dossier-panel", i !== 0 && "hidden"]}
                    style={`--accent:${c.accent};--accent-shadow:${c.shadow}`}
                >
                    {/* ID card */}
                    <article class="dossier relative border-2 border-[var(--accent)] bg-[#0a0a0a]/90 shadow-[8px_8px_0_var(--accent-shadow)]">
                        <div class="flex items-center justify-between gap-4 px-5 py-3 border-b-2 border-[var(--accent)] bg-[var(--accent)] text-black font-mono text-[11px] font-bold tracking-[0.2em] uppercase">
                            <span>Subject file // {c.file}</span>
                            <span class="hidden sm:inline">Classification: friendly</span>
                        </div>

                        <div class="grid lg:grid-cols-[380px_1fr]">
                            {/* Square photo with scan line and corner brackets */}
                            <div class="p-6 sm:p-8 lg:border-r-2 border-[#222]">
                                <div class="scan-frame relative aspect-square overflow-hidden">
                                    <img src={c.image} alt={`${c.name}`} class="w-full h-full object-cover" />
                                    <span class="scan-line" aria-hidden="true" />
                                    <span class="corner tl" /><span class="corner tr" /><span class="corner bl" /><span class="corner br" />
                                </div>
                            </div>

                            {/* Details */}
                            <div class="p-6 sm:p-8 lg:p-10">
                                <p class="font-mono text-[12px] tracking-[0.2em] uppercase text-[#777]">{c.kicker}</p>
                                <h2 class="mt-2 text-6xl sm:text-7xl font-bold text-[var(--accent)] leading-none [text-shadow:0_0_30px_color-mix(in_srgb,var(--accent)_40%,transparent)]">
                                    {c.name}
                                </h2>

                                <dl class="mt-8 grid sm:grid-cols-2 gap-x-8 gap-y-3">
                                    {c.stats.map(({ label, value }) => (
                                        <div class="flex items-baseline gap-3 font-mono text-[13px]">
                                            <dt class="shrink-0 uppercase tracking-widest text-[#777]">{label}</dt>
                                            <span class="flex-1 border-b border-dotted border-[#444] translate-y-[-4px]" aria-hidden="true" />
                                            <dd class="text-white font-bold text-right">{value}</dd>
                                        </div>
                                    ))}
                                </dl>

                                <div class="mt-8 space-y-4">
                                    {c.bio.map((paragraph) => (
                                        <p class="text-[#ccc] text-base sm:text-[17px] leading-relaxed">{paragraph}</p>
                                    ))}
                                </div>

                                <a
                                    href="/socials"
                                    class="mt-8 inline-flex items-center gap-2 font-bold py-3 px-6 border-2 text-[13px] tracking-widest uppercase
                bg-[var(--accent)] text-black border-[var(--accent-shadow)]
                shadow-[4px_4px_0_var(--accent-shadow)] hover:shadow-[2px_2px_0_var(--accent-shadow)]
                hover:translate-x-0.5 hover:translate-y-0.5 active:shadow-none active:translate-x-1 active:translate-y-1
                transition-all duration-100"
                                >
                                    <MessagesSquare size={16} />
                                    Get in touch
                                </a>
                            </div>
                        </div>
                    </article>

                    {c.notice && (
                        <Notice type={c.notice.type} title={c.notice.title} class="mt-10">
                            {c.notice.body}
                        </Notice>
                    )}

                    {/* Photos */}
                    <div class="mt-24">
                        <h3 class="section-title"><span>01</span>{c.photosHeading}</h3>
                        <PhotoGallery photos={c.photos.map((src) => ({ src }))} />
                    </div>

                    {/* Palette */}
                    <div class="mt-24">
                        <h3 class="section-title"><span>02</span>Colour reference</h3>
                        <p class="text-[#888] -mt-4 mb-8">For commissions and fan art — click a colour to copy its hex code.</p>
                        <div class="palette flex flex-col sm:flex-row border-2 border-[#333] shadow-[6px_6px_0_var(--accent-shadow)]">
                            {c.palette.map(({ label, hex }) => (
                                <button
                                    type="button"
                                    class="swatch group relative flex-1 min-h-[72px] sm:min-h-[200px] flex flex-col justify-end p-4 text-left"
                                    style={`background:${hex}`}
                                    data-hex={hex}
                                    aria-label={`Copy ${label} colour ${hex}`}
                                >
                                    <span class="swatch-label inline-flex flex-col gap-1 bg-black/75 px-3 py-2 self-start">
                                        <span class="text-[11px] font-bold tracking-widest uppercase text-white">{label}</span>
                                        <span class="swatch-hex flex items-center gap-1.5 font-mono text-[12px] text-[#bbb]">
                                            {hex}
                                            <Copy size={11} class="opacity-0 group-hover:opacity-100 transition-opacity" />
                                        </span>
                                    </span>
                                </button>
                            ))}
                        </div>
                    </div>

                    {/* Notes */}
                    <div class="mt-24">
                        <h3 class="section-title"><span>03</span>Notes</h3>
                        <div class="grid sm:grid-cols-3 gap-4">
                            {c.misc.map((item, n) => (
                                <div class="relative border-2 border-[#333] bg-[#0a0a0a] p-6 hover:border-[var(--accent)] hover:shadow-[4px_4px_0_var(--accent-shadow)] transition-all">
                                    <span class="block font-mono text-4xl font-bold text-[var(--accent)]/30 mb-3">
                                        {String(n + 1).padStart(2, "0")}
                                    </span>
                                    <p class="text-[#ccc] leading-relaxed">{item}</p>
                                </div>
                            ))}
                        </div>
                    </div>

                    {/* Lore, as a corrupted terminal log */}
                    {c.originLore && (
                        <div class="mt-24">
                            <h3 class="section-title"><span>04</span>Origin</h3>
                            <div class="terminal border-2 border-[var(--accent)] bg-[#050505] shadow-[6px_6px_0_var(--accent-shadow)]">
                                <div class="flex items-center gap-2 px-4 py-2.5 border-b-2 border-[#222] font-mono text-[11px] text-[#777]">
                                    <span class="w-2.5 h-2.5 rounded-full bg-[#ef4444]" />
                                    <span class="w-2.5 h-2.5 rounded-full bg-[#f59e0b]" />
                                    <span class="w-2.5 h-2.5 rounded-full bg-[#22c55e]" />
                                    <span class="ml-3">~/archive/{c.id}/origin.log</span>
                                </div>
                                <div class="p-6 sm:p-8 font-mono text-[14px] leading-relaxed">
                                    <p class="text-[#777] mb-4">$ cat origin.log</p>
                                    <p class="text-[#ccc] mb-5">
                                        {c.originLore.intro}{" "}
                                        <span class="glitch-text text-[var(--accent)]" data-text={c.originLore.glitchWord}>
                                            {c.originLore.glitchWord}
                                        </span>
                                    </p>
                                    <p class="mb-5">
                                        <span class="glitch-text text-[#ef4444]" data-text={c.originLore.corrupted}>
                                            {c.originLore.corrupted}
                                        </span>
                                    </p>
                                    <p class="text-[#888]">
                                        <span class="text-[var(--accent)]">&gt;</span> {c.originLore.note}<span class="caret" aria-hidden="true">_</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            ))}
        </section>

        {/* ── Shared interests ── */}
        <section class="border-t-2 border-[#222] bg-[#0a0a0a]/80">
            <div class="max-w-6xl mx-auto px-6 lg:px-8 py-20">
                <h2 class="text-3xl sm:text-4xl font-bold text-white mb-3">What I'm into</h2>
                <p class="text-[#888] mb-10">The things that keep me busy, no matter whose fur I'm in.</p>
                <div class="divide-y-2 divide-[#222] border-y-2 border-[#222]">
                    {interests.map(({ icon: Icon, title, desc }) => (
                        <div class="group flex items-center gap-6 sm:gap-10 py-7 px-5 sm:px-8 transition-colors hover:bg-[rgba(var(--accent-rgb),0.06)]">
                            <span class="shrink-0 flex items-center justify-center w-14 h-14 border-2 border-[#333] text-[var(--accent)] group-hover:border-[var(--accent)] group-hover:shadow-[3px_3px_0_var(--accent-shadow)] transition-all">
                                <Icon size={26} />
                            </span>
                            <div class="sm:flex sm:items-baseline sm:gap-10 flex-1">
                                <h3 class="sm:w-64 shrink-0 text-lg sm:text-xl font-bold text-white group-hover:text-[var(--accent)] transition-colors">
                                    {title}
                                </h3>
                                <p class="mt-1 sm:mt-0 text-[#aaa] leading-relaxed">{desc}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* Intro slides in line by line */
    .intro-line {
        opacity: 0;
        transform: translateY(14px);
        animation: rise 0.6s ease-out var(--d) forwards;
    }
    @keyframes rise {
        to { opacity: 1; transform: none; }
    }

    .caret {
        color: var(--accent);
        animation: blink 1s steps(1) infinite;
    }
    @keyframes blink {
        50% { opacity: 0; }
    }

    /* Folder tabs above the ID card */
    .file-tab {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
        padding: 10px 22px 8px;
        border: 2px solid var(--c);
        border-bottom: none;
        background: #0a0a0a;
        color: var(--c);
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        font-size: 15px;
        cursor: pointer;
        transition: background 0.15s, color 0.15s, padding 0.15s;
    }
    .file-tab:hover {
        background: color-mix(in srgb, var(--c) 15%, #0a0a0a);
    }
    .file-tab[aria-selected="true"] {
        background: var(--c);
        color: black;
        padding-top: 14px;
    }

    .dossier-panel {
        animation: panelIn 0.4s ease-out;
    }
    @keyframes panelIn {
        from { opacity: 0; transform: translateY(8px); }
    }

    /* Photo frame: corner brackets + a slow scanning line */
    .scan-frame img {
        filter: saturate(1.05) contrast(1.05);
    }
    .scan-frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 3px);
        pointer-events: none;
    }
    .scan-line {
        position: absolute;
        left: 0;
        right: 0;
        height: 40px;
        background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent) 35%, transparent), transparent);
        animation: scan 4s linear infinite;
        pointer-events: none;
    }
    @keyframes scan {
        from { top: -40px; }
        to { top: 100%; }
    }
    .corner {
        position: absolute;
        width: 22px;
        height: 22px;
        border: 3px solid var(--accent);
        z-index: 1;
    }
    .corner.tl { top: 8px; left: 8px; border-right: none; border-bottom: none; }
    .corner.tr { top: 8px; right: 8px; border-left: none; border-bottom: none; }
    .corner.bl { bottom: 8px; left: 8px; border-right: none; border-top: none; }
    .corner.br { bottom: 8px; right: 8px; border-left: none; border-top: none; }

    /* Section headings: index number + title on one line */
    .section-title {
        display: flex;
        align-items: baseline;
        gap: 16px;
        margin-bottom: 32px;
        font-size: 1.875rem;
        font-weight: 700;
        color: white;
    }
    .section-title span {
        font-family: monospace;
        font-size: 0.875rem;
        color: var(--accent);
        padding: 2px 8px;
        border: 2px solid var(--accent);
        transform: translateY(-4px);
    }

    /* Colour swatches grow on hover */
    .swatch {
        transition: flex-grow 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
        cursor: copy;
    }
    .swatch:hover,
    .swatch:focus-visible {
        flex-grow: 1.6;
        outline: none;
    }
    .swatch.copied .swatch-hex {
        color: #4ade80;
    }

    @media (prefers-reduced-motion: reduce) {
        .intro-line,
        .dossier-panel {
            opacity: 1;
            transform: none;
            animation: none;
        }
        .scan-line,
        .caret {
            animation: none;
        }
        .swatch {
            transition: none;
        }
    }
</style>

<script>
    import { getStoredTheme, setStoredTheme } from "../lib/theme";

    const GLITCH_CHARS = "!@#$%^&*<>?/\\|[]{}~`ABCDEFabcdef0123456789";

    function scramble(text: string, tick: number) {
        const glitchChance = tick % 8 === 0 ? 0.9 : 0.4;
        return text
            .split("")
            .map((ch) =>
                ch !== " " && Math.random() < glitchChance
                    ? GLITCH_CHARS[Math.floor(Math.random() * GLITCH_CHARS.length)]
                    : ch,
            )
            .join("");
    }

    function setupGlitchText() {
        document.querySelectorAll<HTMLElement>(".glitch-text").forEach((el) => {
            if (el.dataset.glitchBound) return;
            el.dataset.glitchBound = "true";
            const text = el.dataset.text ?? el.textContent ?? "";
            let tick = 0;
            const timer = setInterval(() => {
                if (!el.isConnected) return clearInterval(timer);
                el.textContent = scramble(text, ++tick);
            }, 80);
        });
    }

    function setupTabs() {
        const buttons = document.querySelectorAll<HTMLButtonElement>("[data-tab-btn]");
        const panels = document.querySelectorAll<HTMLElement>("[data-tab-panel]");

        function activate(id: string | undefined) {
            buttons.forEach((btn) => btn.setAttribute("aria-selected", String(btn.dataset.tabBtn === id)));
            panels.forEach((panel) => panel.classList.toggle("hidden", panel.dataset.tabPanel !== id));
        }

        buttons.forEach((btn) => {
            if (btn.dataset.tabBound) return;
            btn.dataset.tabBound = "true";
            btn.addEventListener("click", () => {
                const id = btn.dataset.tabBtn;
                activate(id);
                if (id === "mars" || id === "lynix") setStoredTheme(id);
            });
        });

        activate(getStoredTheme());
    }

    function setupSwatches() {
        document.querySelectorAll<HTMLButtonElement>(".swatch").forEach((swatch) => {
            if (swatch.dataset.bound) return;
            swatch.dataset.bound = "true";
            const hexEl = swatch.querySelector<HTMLElement>(".swatch-hex")!;
            const hex = swatch.dataset.hex!;
            swatch.addEventListener("click", async () => {
                try {
                    await navigator.clipboard.writeText(hex);
                } catch {
                    return;
                }
                hexEl.firstChild!.textContent = "Copied!";
                swatch.classList.add("copied");
                setTimeout(() => {
                    hexEl.firstChild!.textContent = hex;
                    swatch.classList.remove("copied");
                }, 1200);
            });
        });
    }

    function setup() {
        setupGlitchText();
        setupTabs();
        setupSwatches();
    }

    setup();
    document.addEventListener("astro:after-swap", setup);
</script>
