---
import Layout from "../../layouts/Layout.astro";
import HeroBanner from "../../components/HeroBanner.astro";
import Notice from "../../components/Notice.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { CalendarDays, MapPin, Images } from "@lucide/astro";

const adventures = (
    await getCollection("adventures", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", timeZone: "UTC" });
---

<Layout title="Adventures">
    <main class="flex-1 relative z-10">
        <HeroBanner
            src="/imgs/banner-map.jpg"
            eyebrow="Through my lens"
            subtitle="Stories and photos from the backcountry, the con floor, and everywhere in between."
        >
            Adventures
        </HeroBanner>

        <div class="max-w-6xl mx-auto w-full px-6 lg:px-8 py-20">
            {
                adventures.length === 0 ? (
                    <Notice title="No adventures yet">
                        Check back after the next trip!
                    </Notice>
                ) : (
                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                        {adventures.map(({ id, data }) => (
                            <a
                                href={`/adventures/${id}/`}
                                class="group flex flex-col border-2 border-[#333] bg-[#0a0a0a]
                hover:border-[var(--accent)] shadow-[4px_4px_0_transparent]
                hover:shadow-[4px_4px_0_var(--accent-shadow)]
                hover:-translate-x-0.5 hover:-translate-y-0.5
                transition-all duration-150"
                            >
                                <div class="aspect-[4/3] overflow-hidden border-b-2 border-[#333] group-hover:border-[var(--accent)] transition-colors">
                                    <Image
                                        src={data.cover}
                                        alt=""
                                        width={720}
                                        height={540}
                                        fit="cover"
                                        format="webp"
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                    />
                                </div>

                                <div class="flex flex-col flex-1 p-6">
                                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] font-mono tracking-widest uppercase text-[#666] mb-3">
                                        <span class="flex items-center gap-1.5">
                                            <CalendarDays size={12} />
                                            <time datetime={data.date.toISOString()}>{dateFormatter.format(data.date)}</time>
                                        </span>
                                        {data.location && (
                                            <span class="flex items-center gap-1.5">
                                                <MapPin size={12} />
                                                {data.location}
                                            </span>
                                        )}
                                    </div>

                                    <h2 class="text-xl font-bold text-white mb-2 group-hover:text-[var(--accent)] transition-colors">
                                        {data.title}
                                    </h2>
                                    <p class="text-[#888] text-[14px] leading-relaxed flex-1 mb-5">
                                        {data.description}
                                    </p>

                                    <div class="flex items-center gap-2 text-[11px] font-bold tracking-widest uppercase text-[#777] group-hover:text-[var(--accent)] transition-colors">
                                        <Images size={13} />
                                        <span>{data.photos.length} photo{data.photos.length === 1 ? "" : "s"}</span>
                                        <span class="ml-auto transition-transform group-hover:translate-x-1">→</span>
                                    </div>
                                </div>
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </main>
</Layout>
